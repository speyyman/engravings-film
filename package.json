{
  "name": "engravings-film",
  "version": "1.0.0",
  "private": true,
  "description": "A short film that draws a fern, a sunflower and the moon from their rules, rendered frame by frame from a canvas and encoded with ffmpeg.",
  "license": "MIT",
  "author": "Saeed Peyman",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite render",
    "build": "vite build render --outDir ../dist --emptyOutDir",
    "render": "npm run build && node scripts/render.mjs",
    "render:preview": "npm run build && node scripts/render.mjs --preview",
    "test": "vitest run",
    "e2e": "npm run build && node test/e2e.mjs",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fontsource/big-shoulders-display": "5.3.0",
    "@fontsource/geist-mono": "5.3.0",
    "plate-engine": "0.1.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "26.6.5",
    "eslint": "10.13.0",
    "globals": "17.13.0",
    "playwright": "1.64.1",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.0",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
